# =============================================================================
# TEST ENVIRONMENT OVERRIDES
# =============================================================================
#
# Loaded by tests/setup.ts AFTER .env, with override: true.
# Any variable set here overrides the value from .env during test runs.
#
# This file is COMMITTED to git. It must never contain real production
# secrets. It is intended for test-only configuration: pointing at a
# dedicated test DB, silencing logs, disabling external API calls, etc.
#
# If a test override ever needs to be secret (e.g. a dedicated Kinde test
# tenant), put it in .env.test.local (gitignored) instead.
#
# =============================================================================

# Currently, tests run against the same local Postgres as development.
# When a dedicated test DB is introduced, change this to:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/store_manager_test
#
# Leaving it explicit (not relying on .env) makes it obvious which DB tests hit.
DATABASE_URL=postgresql://postgres:password@localhost:5432/store_manager

