# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL=postgresql://user:password@localhost:5432/store_manager 

# kinde auth secrets
KINDE_CLIENT_ID=<kinde-client-id>
KINDE_CLIENT_SECRET=<kinde-client-secret>
KINDE_ISSUER_URL=<kinde-isuser-url>

# for development, replace with your actual url in production
KINDE_SITE_URL=http://localhost:3000 
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000 
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard


# Cloudflare R2 — required only when submitting or installing extensions
# from the store. Local test runs mock these. See lib/storage/r2Client.ts
# for the exact shape of each var.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional CDN prefix for PipelineResult.url. Leave empty to default to
# r2://<bucket>. Do NOT parse the resulting URL — see media-pipeline
# integration guide §4.1.
R2_PUBLIC_URL_BASE=