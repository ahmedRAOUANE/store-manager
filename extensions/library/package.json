{
    "name": "@store-manager/extensions",
    "version": "1.0.0",
    "description": "Extension SDK for store-manager",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "bin": {
        "store-manager-ext": "./src/cli/index.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./test": {
            "types": "./src/test/index.ts",
            "import": "./src/test/index.ts"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": false,
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "vitest": "^5.0.5",
        "zod": "^4.5.4"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "esbuild": "^0.28.2",
        "ts-morph": "^24",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5",
        "zod": "^4.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}